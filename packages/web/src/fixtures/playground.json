{
  "rev": 11,
  "nodes": [
    {
      "id": "ledgerly-api",
      "parentId": null,
      "label": "the service",
      "summary": "The way apps get things done: create groups, log what someone paid, ask who owes whom — open to anyone who can reach it, with no sign-in at all.",
      "phase": "built",
      "codeRefs": [
        "apps/api"
      ],
      "kind": "api"
    },
    {
      "id": "ledgerly-cli",
      "parentId": null,
      "label": "operator tool",
      "summary": "Lets an operator type commands to create sample data, load a batch of expenses from a spreadsheet file, and print who owes whom.",
      "phase": "built",
      "codeRefs": [
        "apps/cli"
      ],
      "kind": "service"
    },
    {
      "id": "ledgerly-web",
      "parentId": null,
      "label": "web page",
      "summary": "Shows people their groups, every expense, each person's balance and the suggested payments — but only lets them look, plus one button to send the settle-up summary.",
      "phase": "built",
      "codeRefs": [
        "apps/web"
      ],
      "kind": "ui"
    },
    {
      "id": "ledgerly-worker",
      "parentId": null,
      "label": "background helper",
      "summary": "Runs unattended on a repeating timer, nudging only people who genuinely still owe money and mailing out group balance summaries.",
      "phase": "built",
      "codeRefs": [
        "apps/worker"
      ],
      "kind": "service"
    },
    {
      "id": "ledgerly-config",
      "parentId": null,
      "label": "settings",
      "summary": "Gives every part of the system a working set of choices out of the box, and refuses to start on a setting it knows is nonsense.",
      "phase": "built",
      "codeRefs": [
        "packages/config"
      ],
      "kind": "service"
    },
    {
      "id": "ledgerly-domain",
      "parentId": null,
      "label": "fairness rules",
      "summary": "The single authority on shared money: it decides what each person owes, who is behind, and the shortest list of payments that squares everyone up.",
      "phase": "built",
      "codeRefs": [
        "packages/domain"
      ],
      "kind": "service"
    },
    {
      "id": "ledgerly-notify",
      "parentId": null,
      "label": "messages out",
      "summary": "Turns balances and settle-up plans into plain readable notices and delivers them to the screen or a log file, standing in for real email.",
      "phase": "built",
      "codeRefs": [
        "packages/notify"
      ],
      "kind": "service"
    },
    {
      "id": "ledgerly-queue",
      "parentId": null,
      "label": "waiting work",
      "summary": "Holds work that should happen soon, retrying a few times with growing pauses when it fails, but forgets everything if the program stops.",
      "phase": "built",
      "codeRefs": [
        "packages/queue"
      ],
      "kind": "queue"
    },
    {
      "id": "ledgerly-store",
      "parentId": null,
      "label": "saved records",
      "summary": "Keeps every group and expense safely on disk, and promises a reader never sees a half-written file even if the machine dies mid-save.",
      "phase": "built",
      "codeRefs": [
        "packages/store"
      ],
      "kind": "store"
    },
    {
      "id": "store-safe-write",
      "parentId": "ledgerly-store",
      "label": "crash-proof saving",
      "summary": "Writes changes to a side copy first and only then swaps it in, so an interrupted save can never corrupt the records.",
      "phase": "built",
      "kind": "store",
      "codeRefs": [
        "packages/store/src/atomic.ts",
        "packages/store/src/json-file-store.ts"
      ]
    },
    {
      "id": "store-scratch",
      "parentId": "ledgerly-store",
      "label": "throwaway copy",
      "summary": "Offers an identical set of records that lives only in memory and vanishes on exit, so tests and trial runs never touch real data.",
      "phase": "built",
      "kind": "store",
      "codeRefs": [
        "packages/store/src/memory-store.ts"
      ]
    },
    {
      "id": "domain-splits",
      "parentId": "ledgerly-domain",
      "label": "dividing a bill",
      "summary": "Divides any bill evenly, by exact amounts, or by percentage shares, and guarantees the parts always add back up to the original with no stray penny lost or invented.",
      "phase": "built",
      "kind": "service",
      "codeRefs": [
        "packages/domain/src/split",
        "packages/domain/src/money.ts"
      ]
    },
    {
      "id": "domain-settlement",
      "parentId": "ledgerly-domain",
      "label": "who pays whom",
      "summary": "Turns a tangle of debts into the fewest possible payments, and can prove afterwards that following them leaves everybody square.",
      "phase": "built",
      "kind": "service",
      "codeRefs": [
        "packages/domain/src/settlement.ts",
        "packages/domain/src/balances.ts"
      ]
    },
    {
      "id": "api-no-auth",
      "parentId": "ledgerly-api",
      "label": "no door lock",
      "summary": "There is no sign-in and no permission check anywhere: every request is trusted and any caller can read or delete any group's money records.",
      "phase": "built",
      "kind": "security",
      "codeRefs": [
        "apps/api/src/server.ts",
        "apps/api/src/router.ts",
        "apps/api/src/context.ts"
      ]
    },
    {
      "id": "web-read-only",
      "parentId": "ledgerly-web",
      "label": "look, don't touch",
      "summary": "The screens have no way to add a group, log an expense, or change members, so all real data entry has to happen through the command-line tool.",
      "phase": "built",
      "kind": "ui",
      "codeRefs": [
        "apps/web/src/components/ExpenseList.tsx",
        "apps/web/src/components/BalanceTable.tsx",
        "apps/web/src/pages/GroupsPage.tsx"
      ]
    },
    {
      "id": "worker-recheck",
      "parentId": "ledgerly-worker",
      "label": "checks before nagging",
      "summary": "Recalculates a person's balance at the moment of sending and stays silent if they have already settled up, so nobody is chased for a debt they paid.",
      "phase": "built",
      "kind": "service",
      "codeRefs": [
        "apps/worker/src/jobs/reminder.ts"
      ]
    },
    {
      "id": "worker-snapshot-gap",
      "parentId": "ledgerly-worker",
      "label": "summaries aren't nightly",
      "summary": "Group summaries are sent once when the helper starts up rather than every night, because nothing in the system tracks a calendar or time of day.",
      "phase": "built",
      "kind": "service",
      "codeRefs": [
        "apps/worker/src/jobs/snapshot.ts",
        "apps/worker/src/main.ts"
      ]
    },

{
  "name": "shape",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "description": "Voice-driven, canvas-first frontend for the omp harness",
  "scripts": {
    "bridge": "pnpm --filter @shape/bridge start",
    "server": "pnpm --filter @shape/bridge server",
    "agent": "pnpm --filter @shape/bridge agent",
    "login": "pnpm --filter @shape/bridge login",
    "smoke:auth": "pnpm --filter @shape/bridge smoke:auth",
    "smoke:remote": "pnpm --filter @shape/bridge smoke:remote",
    "smoke:wire": "pnpm --filter @shape/bridge smoke:wire",
    "smoke:herdr": "pnpm --filter @shape/bridge smoke:herdr",
    "web": "pnpm --filter @shape/web dev",
    "smoke:shared": "pnpm --filter @shape/shared smoke",
    "smoke:link-cli": "pnpm --filter @shape/link smoke:link-cli",
    "link:mcp": "node packages/link/src/mcp.ts",
    "link:canvas": "node packages/link/src/cli.ts"
  }
}
